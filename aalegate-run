#!/usr/bin/env python3
"""aalegate-run---unified launcher for all aalegate runtimes.

    aalegate-run --runtime <docker|podman|apptainer|kata> --agent <IMAGE|SIF> --llm <URL>
                 [--work DIR] [--gpu nvidia] [--egress gh,pypi] [--shell] [--dry-run]
                 [-- <agent command...>]

The recorder (aalegate-gateway) is runtime-agnostic: same hash-chained provenance
regardless of whether the agent runs in Docker, Podman, Apptainer, or Kata.
"""
import argparse
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

from recorder import EGRESS_DOMAINS, DEFAULT_AUDIT_ROOT, resolve_agent, agent_defaults, session_candidates


def build_parser():
    p = argparse.ArgumentParser(
        description="Record an agent session through the aalegate L7 recorder.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""\
examples:
  # Claude Code (subscription OAuth, Docker):
  aalegate-run --runtime docker --agent aalegate-claude-code --subscription --dotfile claude --work .
  # Claude Code (subscription OAuth, Podman):
  aalegate-run --runtime podman --agent aalegate-claude-code --subscription --dotfile claude --work .
  # Podman (rootless, shared GPU):
  aalegate-run --runtime podman --agent pi --llm http://127.0.0.1:8014 --work ./work -p "task"
  # Docker (key custody):
  aalegate-run --runtime docker --agent pi --llm https://api.anthropic.com --api anthropic \\
    --llm-key-file ~/.aalegate/claude.key --work ./work -p "task"
  # Apptainer (HPC, enforced airgap by default; needs unshare, ip, slirp4netns):
  aalegate-run --runtime apptainer --agent aalegate-pi.sif --llm http://127.0.0.1:8080 \\
    --work ./work -p "task"
  # Kata (hypervisor isolation):
  aalegate-run --runtime kata --agent pi --llm http://127.0.0.1:8014 --work ./work -p "task"
""")

    p.add_argument("--runtime", required=True, choices=["docker", "podman", "apptainer", "kata"],
                   help="container runtime for the agent")
    p.add_argument("--agent", required=True, metavar="IMAGE",
                   help="agent image (catalog: pi, pi-cuda) or raw name/path")
    p.add_argument("--llm", metavar="URL", default=None,
                   help="endpoint of the already-running LLM (default: per agent catalog)")
    p.add_argument("--api", choices=["openai", "anthropic", "llama"], default=None,
                   help="dialect hint recorded in the index (default: per agent catalog, else openai)")

    p.add_argument("--work", nargs="+", action="extend", default=[], metavar="DIR")
    p.add_argument("--work-ro", nargs="+", action="extend", default=[], metavar="DIR")
    p.add_argument("--data", nargs="+", action="extend", default=[], metavar="DIR")
    p.add_argument("--data-rw", nargs="+", action="extend", default=[], metavar="DIR")
    p.add_argument("--mount", action="append", default=[], metavar="HOST:CTR[:ro]",
                   help="extra bind mount (repeatable)")

    p.add_argument("--egress", metavar="GROUPS",
                   help=f"web via allow-list---{sorted(EGRESS_DOMAINS)} or 'all'")
    p.add_argument("--allow", action="append", metavar="HOST[:PORT]", default=None,
                   help="allow the agent to reach a specific host (or host:port) via the egress "
                        "proxy. Repeatable. Implies egress. Examples: --allow 192.168.1.100:8080 "
                        "--allow api.openai.com --allow myhost.lan:9999")
    p.add_argument("--gpu", choices=["nvidia", "intel", "both"], default=None)

    p.add_argument("--llm-verify", action="store_true")
    p.add_argument("--llm-key", metavar="KEY", default=None)
    p.add_argument("--llm-key-file", metavar="PATH", default=None,
                   help="file holding the upstream API key (recommended)")
    p.add_argument("--llm-key-env", metavar="VAR", default=None,
                   help="env var holding the upstream API key")
    p.add_argument("--llm-net", metavar="NET", default=None,
                   help="docker/podman network the recorder joins to reach --llm")

    p.add_argument("--subscription", action="store_true",
                   help="(anthropic) subscription/OAuth auth: the agent logs in itself and the "
                        "recorder forwards the bearer upstream (no key custody). Auto-allows the "
                        "'anthropic' egress lane for OAuth login/refresh")
    p.add_argument("--local", action="store_true",
                   help="(anthropic) use a LOCAL Anthropic-compatible server (e.g. llama.cpp "
                        "/v1/messages): map Claude's model tiers to the served model, set the "
                        "context window from /props, disable the attribution header. Pair with "
                        "--llm (+ --llm-key* if the server enforces --api-key). Excludes --subscription")
    p.add_argument("--dotfile", nargs="+", action="extend", default=[], metavar="NAME",
                   help="bind-mount host ~/.NAME (rw) into the agent's home so that agent's state "
                        "(login, settings) persists across runs. Repeatable: --dotfile claude pi "
                        "mounts ~/.claude and ~/.pi (default: none; ephemeral per-run home)")

    p.add_argument("--recorder-name", metavar="NAME", default="llm-gateway")
    p.add_argument("--as-root", action="store_true")
    p.add_argument("--shell", action="store_true",
                   help="self-wire, then drop into an interactive shell")
    p.add_argument("--no-hash", action="store_true")
    p.add_argument("--audit-root", default=str(DEFAULT_AUDIT_ROOT),
                   help="run store root (default: $AALE_AUDIT_ROOT or ~/.local/state/aalegate)")
    p.add_argument("--project", metavar="DIR", default=None,
                   help="project dir that names the run's audit bucket "
                        "(<audit-root>/<basename>__<hash>/<run-id>/); "
                        "default: derived from --work (see -y), else CWD")
    p.add_argument("-y", "--yes", action="store_true",
                   help="skip the session-root prompt for multiple --work dirs; take the "
                        "top-ranked candidate (broadest shared parent)")
    p.add_argument("--run-id", default=None)
    p.add_argument("-p", "--prompt", metavar="TEXT", default=None)
    p.add_argument("--dry-run", action="store_true")

    # apptainer-specific
    p.add_argument("--netns", action=argparse.BooleanOptionalAction, default=None,
                   help="(apptainer) run in a rootless network namespace (enforced airgap; the "
                        "default). --no-netns shares the host network: the airgap is policy only "
                        "and tools that ignore HTTPS_PROXY bypass the egress proxy, unlogged")
    p.add_argument("--recorder-host", metavar="HOST", default=None)
    p.add_argument("--port", type=int, default=None)

    # podman-specific
    p.add_argument("--wire", metavar="PROFILE", default=None,
                   help="(podman) self-wire an un-catalogued image at runtime")
    p.add_argument("--manifest", metavar="FILE", default=None,
                   help="(podman) custom harness.json for runtime wiring")

    p.add_argument("cmd", nargs=argparse.REMAINDER, help="-- <agent command...>")
    return p


def resolve_session_root(args):
    """Choose the dir whose basename+hash names this run's audit bucket. Explicit --project
    wins. Otherwise derive from --work: one dir is used as-is; several present a ranked
    prompt (broadest shared parent first). -y or no TTY takes the top candidate; no --work
    falls back to the recorder default (CWD)."""
    if args.project:
        return args.project
    cands = session_candidates(getattr(args, "work", []) or [])
    if not cands:
        return None
    if len(cands) == 1:
        return str(cands[0][0])
    top = str(cands[0][0])
    if args.yes or not (sys.stdin.isatty() and sys.stderr.isatty()):
        why = "-y" if args.yes else "no TTY"
        print(f"aalegate: multiple --work dirs; session root = {top}  ({why}; --project overrides)",
              file=sys.stderr)
        return top
    return str(_prompt_session_root(cands))


def _prompt_session_root(cands):
    print("Multiple --work dirs. Choose the session root that names the audit bucket "
          "(broadest shared parent first):", file=sys.stderr)
    for i, (c, cov) in enumerate(cands, 1):
        tag = f"{cov} work dirs" if cov > 1 else "work dir"
        print(f"  {i:2d}) {c}   [{tag}]", file=sys.stderr)
    while True:
        sys.stderr.write(f"select [1-{len(cands)}] (default 1): ")
        sys.stderr.flush()
        line = sys.stdin.readline()
        if not line.strip():
            return cands[0][0]                 # EOF / blank -> default #1
        s = line.strip()
        if s.isdigit() and 1 <= int(s) <= len(cands):
            return cands[int(s) - 1][0]
        print(f"  enter a number 1-{len(cands)}", file=sys.stderr)


def main():
    args = build_parser().parse_args()
    defaults = agent_defaults(args.agent)
    args.agent = resolve_agent(args.agent)
    for k, v in defaults.items():
        if getattr(args, k, None) is None:
            setattr(args, k, v)
    if args.subscription:
        if args.llm is None:
            args.llm = "https://api.anthropic.com"
        if args.api is None:
            args.api = "anthropic"
    if args.llm is None:
        sys.exit("error: --llm is required (no default for this agent)")
    if args.api is None:
        args.api = "openai"
    args.project = resolve_session_root(args)

    if args.runtime == "docker":
        from runtimes.docker import run
    elif args.runtime == "podman":
        from runtimes.podman import run
    elif args.runtime == "apptainer":
        from runtimes.apptainer import run
    elif args.runtime == "kata":
        from runtimes.kata import run
    else:
        sys.exit(f"unknown runtime: {args.runtime}")

    sys.exit(run(args))


if __name__ == "__main__":
    main()
